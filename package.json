{
  "name": "anybid",
  "private": true,
  "version": "0.1.0",
  "description": "AnyBid \u2014 bidding-first marketplace (API, web, Expo mobile for iOS/Android/Huawei)",
  "workspaces": [
    "packages/*",
    "apps/api",
    "apps/web",
    "apps/mobile"
  ],
  "engines": {
    "node": ">=20.18"
  },
  "scripts": {
    "build": "npm run build -w @anybid/shared && npm run build -w @anybid/api && npm run build -w @anybid/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test -w @anybid/shared && npm run test -w @anybid/api",
    "db:up": "docker compose up -d postgres redis",
    "db:down": "docker compose down",
    "db:push": "npm run db:push -w @anybid/api",
    "db:migrate": "npm run db:migrate -w @anybid/api",
    "db:seed": "npm run db:seed -w @anybid/api",
    "db:reset": "npm run db:reset -w @anybid/api",
    "smoke": "npm run db:seed && tsx apps/api/scripts/smoke.ts",
    "dev": "concurrently -n api,web -c cyan,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run dev -w @anybid/api",
    "dev:web": "npm run dev -w @anybid/web",
    "dev:mobile": "npm run start -w @anybid/mobile",
    "bootstrap": "npm install && npm run db:up && npm run db:push && npm run db:seed"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "ruflo": "^3.38.21",
    "typescript": "5.9.3"
  }
}
