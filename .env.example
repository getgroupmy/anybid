# ---- shared ----
NODE_ENV=development

# ---- api (apps/api/.env) ----
DATABASE_URL="postgresql://anybid:anybid@localhost:5432/anybid?schema=public"
REDIS_URL="redis://localhost:6379"
API_PORT=4000
API_HOST=0.0.0.0
JWT_SECRET="change-me-in-production-please-use-32-bytes-min"
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000
PUBLIC_API_URL="http://localhost:4000"
UPLOAD_DIR="./uploads"
PLATFORM_CURRENCY=MYR
SETTLEMENT_TICK_MS=5000

# ---- web (apps/web/.env.local) ----
NEXT_PUBLIC_API_URL="http://localhost:4000"
NEXT_PUBLIC_WS_URL="ws://localhost:4000/realtime"

# ---- mobile (apps/mobile/.env) ----
EXPO_PUBLIC_API_URL="http://localhost:4000"
EXPO_PUBLIC_WS_URL="ws://localhost:4000/realtime"
# google | huawei  (huawei build strips all Google Mobile Services dependencies)
EXPO_PUBLIC_DIST_CHANNEL=google
