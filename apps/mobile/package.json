{
  "name": "@anybid/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "prebuild:huawei": "EXPO_PUBLIC_DIST_CHANNEL=huawei expo prebuild -p android --clean",
    "build:huawei": "EXPO_PUBLIC_DIST_CHANNEL=huawei eas build -p android --profile huawei",
    "build:android": "eas build -p android --profile production",
    "build:ios": "eas build -p ios --profile production",
    "strip:gms": "npm uninstall expo-notifications --workspace @anybid/mobile",
    "prestart": "npm run build -w @anybid/shared"
  },
  "dependencies": {
    "@anybid/shared": "*",
    "@expo/vector-icons": "^15.0.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~54.0.0",
    "expo-constants": "~18.0.0",
    "expo-haptics": "~15.0.0",
    "expo-image": "~3.0.0",
    "expo-image-picker": "~17.0.0",
    "expo-linking": "~8.0.0",
    "expo-notifications": "^0.32.17",
    "expo-router": "~6.0.0",
    "expo-secure-store": "~15.0.0",
    "expo-status-bar": "~3.0.0",
    "react": "19.1.9",
    "react-native": "0.81.6",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/react": "^19.0.2",
    "typescript": "5.9.3"
  }
}
