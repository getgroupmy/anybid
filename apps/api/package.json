{
  "name": "@anybid/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/server.ts",
    "start": "node dist/src/server.js",
    "build": "prisma generate && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset --force --skip-seed && tsx prisma/seed.ts",
    "worker": "tsx src/workers/settlement-worker.ts",
    "start:worker": "node dist/src/workers/settlement-worker.js",
    "predev": "npm run build -w @anybid/shared",
    "pretypecheck": "npm run build -w @anybid/shared",
    "predb:seed": "npm run build -w @anybid/shared"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@anybid/shared": "*",
    "@aws-sdk/client-s3": "^3.1146.0",
    "@fastify/cors": "^10.0.1",
    "@fastify/multipart": "^9.0.1",
    "@fastify/rate-limit": "^10.2.1",
    "@fastify/static": "^8.0.3",
    "@fastify/websocket": "^11.0.1",
    "@prisma/client": "6.19.3",
    "fastify": "^5.2.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/ws": "^8.18.1",
    "prisma": "6.19.3",
    "tsx": "^4.19.2",
    "typescript": "5.9.3"
  }
}
